{{- print "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<?xml-stylesheet type="text/xsl" href="/sitemap.xsl"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{/* Include home explicitly */}}
  {{ with .Site.Home }}
    <url>
      <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
      <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}
    </url>
  {{ end }}

  {{/* Only regular pages that are NOT sitemap.disabled and NOT index:false */}}
  {{- $pages := where .Site.RegularPages "Sitemap.Disable" "ne" true -}}
  {{- $pages = where $pages "Params.index" "ne" false -}}
  {{- range $pages }}
    <url>
      <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
      <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}
    </url>
  {{- end }}
</urlset>
