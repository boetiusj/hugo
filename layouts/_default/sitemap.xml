{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\n<?xml-stylesheet type=\"text/xsl\" href=\"/sitemap.xsl\"?>" | safeHTML -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  {{/* Always include the homepage once */}}
  {{ with .Site.Home }}
    <url>
      <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
      <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}
    </url>
  {{ end }}

  {{/* Only regular pages that are NOT sitemap.disabled, NOT index:false, and NOT under /ai/ */}}
  {{- $pages := where .Site.RegularPages "Sitemap.Disable" "ne" true -}}
  {{- $pages = where $pages "Params.index" "ne" false -}}
  {{- range $pages -}}
    {{- $isAI := strings.HasPrefix .RelPermalink "/ai/" -}}
    {{- if not $isAI -}}
      <url>
        <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
        <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}
        <changefreq>weekly</changefreq>
        <priority>0.5</priority>
      </url>
    {{- end -}}
  {{- end -}}

</urlset>
